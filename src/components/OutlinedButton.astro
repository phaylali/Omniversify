---
interface Props {
  href: string;
  label: string;
  class?: string;
}

const { href, label, class: className = "" } = Astro.props;
---

<a
  href={href}
  class={`inline-flex items-center gap-2 px-6 py-3 border-2 border-gold text-gold rounded-lg transition-all duration-200 hover:bg-gold hover:text-black no-underline ${className}`}
>
  <slot />
  <span>{label}</span>
</a>
