---
import Section from "./Section.astro";
import faviconSvg from "../../public/favicon.svg?raw";
import cornerSvg from "../assets/corner.svg?raw";
import AudioDiveButton from "./AudioDiveButton.astro";
---

<Section class="h-screen relative">
  <div
    class="absolute bottom-2.5 left-2.5 w-[120px] h-auto pointer-events-none opacity-60 z-10 [&_svg]:w-full [&_svg]:h-auto [&_svg]:block"
    set:html={cornerSvg}
  />
  <div
    class="absolute bottom-2.5 right-2.5 w-[120px] h-auto pointer-events-none opacity-60 z-10 scale-x-[-1] [&_svg]:w-full [&_svg]:h-auto [&_svg]:block"
    set:html={cornerSvg}
  />
  <div class="text-center text-white flex flex-col items-center justify-center w-full px-2 sm:px-4">
    <div
      class="mb-6 sm:mb-8 animate-pulse w-[80px] h-[80px] sm:w-[100px] sm:h-[100px] md:w-[120px] md:h-[120px] flex items-center justify-center"
    >
      <div
        class="w-full h-full [&_svg]:w-full [&_svg]:h-full [&_svg]:block"
        set:html={faviconSvg}
      />
    </div>
    <h1 class="gradient-title text-3xl sm:text-4xl md:text-6xl lg:text-7xl">Omniversify</h1>
    <p class="text-gold text-sm sm:text-base md:text-xl">
      Where the Forgotten Become Immortal.
    </p>
  </div>
  <AudioDiveButton />
</Section>
