---
import Section from "./Section.astro";
import faviconSvg from "../../public/favicon.svg?raw";
import cornerSvg from "../assets/corner.svg?raw";
---

<Section class="hero-section">
  <div class="corner corner-left" set:html={cornerSvg} />
  <div class="corner corner-right" set:html={cornerSvg} />
  <div class="text-center text-white flex flex-col items-center justify-center">
    <div class="mb-8 animate-pulse w-[120px] h-[120px] flex items-center justify-center">
      <div class="logo" set:html={faviconSvg} />
    </div>
    <h1 class="gradient-title">
      Omniversify
    </h1>
    <p class="text-2xl text-gold font-light">Where the Forgotten Become Immortal.</p>
  </div>
</Section>

<style is:global>
  .hero-section {
    height: 100vh;
  }
</style>

<style>
  .logo {
    width: 100%;
    height: 100%;
  }

  .logo :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
    transform: translate(-11.5%, -11.5%);
  }

  .corner {
    position: absolute;
    bottom: 10px;
    width: 120px;
    height: auto;
    pointer-events: none;
    opacity: 0.6;
    z-index: 1;
  }

  .corner-left {
    left: 10px;
  }

  .corner-right {
    right: 10px;
    transform: scaleX(-1);
  }

  .corner :global(svg) {
    width: 100%;
    height: auto;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2.5rem;
    }

    p {
      font-size: 1rem;
    }

    .logo-wrapper {
      width: 80px;
      height: 80px;
    }
  }
</style>
