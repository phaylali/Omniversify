---
import Section from "./Section.astro";
import faviconSvg from "../../public/favicon.svg?raw";
import cornerSvg from "../assets/corner.svg?raw";
---

<Section class="h-screen relative">
  <div class="absolute bottom-2.5 left-2.5 w-[120px] h-auto pointer-events-none opacity-60 z-10 [&_svg]:w-full [&_svg]:h-auto [&_svg]:block" set:html={cornerSvg} />
  <div class="absolute bottom-2.5 right-2.5 w-[120px] h-auto pointer-events-none opacity-60 z-10 scale-x-[-1] [&_svg]:w-full [&_svg]:h-auto [&_svg]:block" set:html={cornerSvg} />
  <div class="text-center text-white flex flex-col items-center justify-center">
    <div class="mb-8 animate-pulse w-[120px] h-[120px] flex items-center justify-center">
      <div class="w-full h-full [&_svg]:w-full [&_svg]:h-full [&_svg]:block [&_svg]:-translate-x-[11.5%] [&_svg]:-translate-y-[11.5%]" set:html={faviconSvg} />
    </div>
    <h1 class="gradient-title text-5xl sm:text-4xl">
      Omniversify
    </h1>
    <p class="text-2xl text-gold font-light sm:text-base">Where the Forgotten Become Immortal.</p>
  </div>
</Section>
