---
import Section from "./Section.astro";
import { ProjectsCarousel } from "./ProjectsCarousel";
import { getCollection } from 'astro:content';

interface Props {
  fullHeight?: boolean;
}

const { fullHeight = true } = Astro.props;

const projects = await getCollection('projects');
---

<Section fullHeight={fullHeight}>
  <ProjectsCarousel client:only="react" projects={projects} />
</Section>

<style>
  /* Global styles for the carousel - applied via :global or in global.css */
</style>
