---
interface Props {
  href?: string;
  class?: string;
  hover?: boolean;
}

const { href, class: className, hover = true } = Astro.props;
---

{href ? (
  <a href={href} class:list={[
    "block rounded-xl overflow-hidden no-underline",
    "border-2 border-[#c2b067]/30 bg-black/30 transition-all duration-300",
    hover && "hover:shadow-[0_0_30px_rgba(194,176,103,0.4)] hover:translate-y-[-4px]",
    className
  ]}>
    <slot />
  </a>
) : (
  <div class:list={[
    "rounded-xl p-6 border-2 border-[#c2b067]/30 bg-black/30",
    className
  ]}>
    <slot />
  </div>
)}
