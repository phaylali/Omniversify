---
import Search from "astro-pagefind/components/Search";
---

<button class="bg-transparent border-none text-gold cursor-pointer p-2 flex items-center justify-center hover:opacity-70 transition-opacity" id="searchTrigger" aria-label="Open search">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="11" cy="11" r="8"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
</button>

<div class="fixed top-0 left-0 right-0 bottom-0 bg-black/85 flex items-start justify-center pt-[15vh] z-[10000] opacity-0 invisible transition-all duration-300" id="searchOverlay">
  <div class="w-[90%] max-w-[600px] bg-[#0a0a0a] border-2 border-gold rounded-xl overflow-hidden translate-y-[-20px] transition-transform duration-300" id="searchModal">
    <div class="flex justify-between items-center p-4 border-b border-gold/30">
      <h2 class="m-0 text-gold text-xl font-semibold">Search</h2>
      <button class="bg-transparent border-none text-gold cursor-pointer p-1 flex items-center justify-center hover:opacity-70 transition-opacity" id="closeSearch" aria-label="Close search">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="p-6">
      <Search />
    </div>
  </div>
</div>

<script>
  const trigger = document.getElementById('searchTrigger');
  const overlay = document.getElementById('searchOverlay');
  const modal = document.getElementById('searchModal');
  const closeBtn = document.getElementById('closeSearch');

  function openSearch() {
    overlay.classList.add('!opacity-100', '!visible');
    modal.classList.add('!translate-y-0');
    setTimeout(() => {
      const input = overlay.querySelector('.pagefind-ui__search-input') as HTMLInputElement;
      input?.focus();
    }, 100);
  }

  function closeSearch() {
    overlay.classList.remove('!opacity-100', '!visible');
    modal.classList.remove('!translate-y-0');
  }

  trigger?.addEventListener('click', openSearch);
  closeBtn?.addEventListener('click', closeSearch);
  
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeSearch();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay?.classList.contains('!opacity-100')) {
      closeSearch();
    }
  });
</script>

<style is:global>
  .pagefind-ui {
    width: 100% !important;
  }

  .pagefind-ui__search-input {
    background: #1a1a1a !important;
    border: 2px solid rgba(194, 176, 103, 0.5) !important;
    color: #c2b067 !important;
    font-size: 16px !important;
    padding: 12px 16px !important;
    border-radius: 8px !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  .pagefind-ui__search-input:focus {
    outline: none !important;
    border-color: #c2b067 !important;
  }

  .pagefind-ui__search-input::placeholder {
    color: rgba(194, 176, 103, 0.5) !important;
  }

  .pagefind-ui__search-icon,
  .pagefind-ui__button,
  .pagefind-ui__reset {
    display: none !important;
  }

  [data-pagefind-reset],
  .pagefind-ui__search-clear {
    display: none !important;
    visibility: hidden !important;
    width: 0 !important;
    height: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    border: none !important;
  }

  .pagefind-ui__drawer {
    background: transparent !important;
    border: none !important;
    margin-top: 1rem !important;
    max-height: 50vh !important;
    overflow-y: auto !important;
  }

  .pagefind-ui__result {
    border-bottom: 1px solid rgba(194, 176, 103, 0.3) !important;
    padding: 12px !important;
  }

  .pagefind-ui__result-title,
  .pagefind-ui__result-link {
    color: #c2b067 !important;
    font-weight: 600 !important;
    font-size: 15px !important;
    text-decoration: none !important;
  }

  .pagefind-ui__result-excerpt {
    color: rgba(194, 176, 103, 0.7) !important;
    font-size: 13px !important;
  }

  .pagefind-ui__result-thumb {
    display: none !important;
  }

  .pagefind-ui__message {
    color: rgba(194, 176, 103, 0.6) !important;
    padding: 1rem !important;
  }
</style>
