---
import Section from "./Section.astro";

interface Props {
  fullHeight?: boolean;
}

const { fullHeight = true } = Astro.props;
---

<Section fullHeight={fullHeight}>
  <div class="vision-content">
    <h2>Our Vision</h2>
    <div class="divider"></div>
    <p>
      Omniversify is more than a studio — we are architects of unified multiverses. 
      We believe that every story, every character, and every world deserves to exist 
      in a connected tapestry of imagination.
    </p>
    <p>
      Our mission is to build a singular, cohesive lore that spans across games, 
      anime, series, books, and beyond. A universe where Spider-Man meets Dragon Ball 
      meets The Witcher — not as a crossover, but as a natural expansion of shared 
      mythology.
    </p>
    <p class="highlight">
      One Universe. Infinite Stories. Zero Boundaries.
    </p>
  </div>
</Section>

<style>
  .vision-content {
    max-width: 800px;
    text-align: center;
    color: white;
  }

  h2 {
    font-size: 3rem;
    margin: 0 0 1rem 0;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    background: radial-gradient(circle at 35% 35%, #8a7a3a 0%, #C2B067 50%, #8a7a3a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .divider {
    width: 100px;
    height: 3px;
    background: linear-gradient(90deg, transparent, #C2B067, transparent);
    margin: 0 auto 2rem;
  }

  p {
    font-size: 1.25rem;
    line-height: 1.8;
    color: #C2B067;
    margin: 0 0 1.5rem 0;
  }

  .highlight {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    color: #C2B067;
  }

  @media (max-width: 768px) {
    .vision-content {
      max-width: 100%;
    }

    h2 {
      font-size: 1.75rem;
    }

    p {
      font-size: 1rem;
      text-align: left;
    }

    .highlight {
      font-size: 1.1rem;
    }
  }
</style>
