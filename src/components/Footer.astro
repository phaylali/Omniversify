---
import Section from "./Section.astro";
import faviconSvg from "../../public/favicon.svg?raw";
---

<Section>
  <div class="text-center text-white w-full">
    <div class="flex items-center justify-center gap-4 mb-8">
      <div class="w-16 h-16 [&_svg]:w-full [&_svg]:h-full" set:html={faviconSvg} />
      <span class="text-2xl font-semibold tracking-wider gradient-title">Omniversify</span>
    </div>

    <div class="flex gap-12 justify-center flex-wrap mb-8 sm:gap-8">
      <div class="flex flex-col gap-2">
        <h4 class="my-0 text-base uppercase tracking-wider text-gold">Company</h4>
        <a href="/about" class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity">About</a>
        <a href="#" class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity">Careers</a>
        <a href="#" class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity">Press Kit</a>
      </div>
      <div class="flex flex-col gap-2">
        <h4 class="my-0 text-base uppercase tracking-wider text-gold">Legal</h4>
        <a href="#" class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity">Privacy Policy</a>
        <a href="#" class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity">Terms of Service</a>
        <a href="#" class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity">Cookie Policy</a>
      </div>
      <div class="flex flex-col gap-2">
        <h4 class="my-0 text-base uppercase tracking-wider text-gold">Resources</h4>
        <a href="#" class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity">Documentation</a>
        <a href="#" class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity">API</a>
        <a href="#" class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity">Brand Assets</a>
      </div>
      <div class="flex flex-col gap-2">
        <h4 class="my-0 text-base uppercase tracking-wider text-gold">Community</h4>
        <a href="#" class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity">Discord</a>
        <a href="#" class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity">Twitter</a>
        <a href="#" class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity">GitHub</a>
      </div>
    </div>

    <div class="inline-block mb-8 p-4 bg-gold/10 border border-gold/20 rounded-lg">
      <p class="m-0 mb-2 text-sm text-gold">Open Source Licenses</p>
      <div class="flex gap-4 flex-wrap justify-center">
        <span class="text-sm px-3 py-1 bg-gold/20 rounded text-gold">Astro</span>
        <span class="text-sm px-3 py-1 bg-gold/20 rounded text-gold">React</span>
        <span class="text-sm px-3 py-1 bg-gold/20 rounded text-gold">TailwindCSS</span>
        <span class="text-sm px-3 py-1 bg-gold/20 rounded text-gold">Embla Carousel</span>
        <span class="text-sm px-3 py-1 bg-gold/20 rounded text-gold">Tabler Icons</span>
      </div>
    </div>

    <div class="text-gold">
      <p class="my-1 text-sm">&copy; 2026 Omniversify. All rights reserved.</p>
      <p class="my-1 text-sm">Made with ∞ across the multiverse</p>
    </div>
  </div>
</Section>
