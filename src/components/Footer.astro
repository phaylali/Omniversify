---
import Section from "./Section.astro";
import faviconSvg from "../../public/favicon.svg?raw";
---

<Section>
  <div class="text-center text-white w-full">
    <div class="flex items-center justify-center gap-4 mb-8">
      <div
        class="w-16 h-16 [&_svg]:w-full [&_svg]:h-full"
        set:html={faviconSvg}
      />
      <span class="text-2xl font-semibold tracking-wider gradient-title"
        >Omniversify</span
      >
    </div>

    <div class="flex gap-12 justify-center flex-wrap mb-8 sm:gap-8">
      <div class="flex flex-col gap-2">
        <h2 class="my-0 text-base uppercase tracking-wider text-gold">
          Studio
        </h2>
        <a
          href="/about"
          class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity"
          >About</a
        >
        <a
          href="/about/#team"
          class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity"
          >Team</a
        >
      </div>
      <div class="flex flex-col gap-2">
        <h2 class="my-0 text-base uppercase tracking-wider text-gold">Legal</h2>
        <a
          href="/docs/privacy-policy/"
          class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity"
          >Privacy Policy</a
        >
        <a
          href="/docs/terms/"
          class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity"
          >Terms of Service</a
        >
        <a
          href="/docs/license/"
          class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity"
          >License</a
        >
        <a
          href="/docs/faq/"
          class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity"
          >F.A.Q</a
        >
      </div>
      <div class="flex flex-col gap-2">
        <h2 class="my-0 text-base uppercase tracking-wider text-gold">Setup</h2>
        <a
          href="/docs/software-stack/"
          class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity"
          >Software</a
        >
        <a
          href="/docs/hardware/"
          class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity"
          >Hardware</a
        >
      </div>
      <div class="flex flex-col gap-2">
        <h2 class="my-0 text-base uppercase tracking-wider text-gold">
          Community
        </h2>
        <a
          href="https://discord.omniversify.com"
          class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity"
          >Discord</a
        >
        <a
          href="https://twitter.com/omniversify"
          class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity"
          >Twitter</a
        >
        <a
          href="https://github.com/omniversify"
          class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity"
          >GitHub</a
        >
        <a
          href="/rss.xml"
          class="text-gold no-underline opacity-80 hover:opacity-100 transition-opacity"
          >RSS Feed</a
        >
      </div>
    </div>
  </div>
</Section>
