---
import Section from "./Section.astro";
---

<Section>
  <div class="text-center text-white w-full max-w-[900px] mx-auto">
    <h2 class="gradient-section-title">Support Us</h2>
    <p class="text-xl text-gold mb-12">Help us build infinite worlds</p>

    <div class="flex gap-8 justify-center flex-wrap mb-16 sm:gap-4">
      <a href="https://ko-fi.com/omniversify" class="flex flex-row items-center justify-center gap-4 p-6 sm:p-8 rounded-2xl border-2 border-gold/30 bg-black/30 text-white no-underline transition-all duration-300 min-w-[300px] md:min-w-[400px] hover:shadow-[0_0_30px_rgba(194,176,103,0.4)] hover:-translate-y-1">
        <img src="/images/kofi_logo.svg" alt="Ko-Fi" class="w-20 h-20" />
        <span class="text-gold text-xl sm:text-2xl font-semibold">Keep us going</span>
      </a>
    </div>

    <div class="mt-16 mb-12">
      <h2 class="gradient-section-title">Visit Us</h2>
      <p class="text-lg text-gold mb-6">
        45 Av. Al Massira, Oued Laou, Tetouan 93250, Morocco
      </p>
      <div class="rounded-xl overflow-hidden border-2 border-gold/30 sm:rounded-lg">
        <iframe
          width="100%"
          height="300"
          frameborder="0"
          scrolling="no"
          marginheight="0"
          marginwidth="0"
          src="https://www.openstreetmap.org/export/embed.html?bbox=-5.0870%2C35.4380%2C-5.0825%2C35.4420&layer=mapnik&marker=35.4401%2C-5.0848"
          class="w-full sm:h-[250px]"
          title="Studio location map"
          style="border: 0; filter: grayscale(100%) invert(92%) contrast(83%);"
          loading="lazy"></iframe>
      </div>
      <div class="flex gap-4 mt-4 justify-center">
        <a
          href="https://www.openstreetmap.org/node/13663830573"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4 py-2 rounded-lg border border-gold/50 text-gold hover:bg-gold/10 transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
            ></path>
          </svg>
          OpenStreetMap
        </a>
        <a
          href="https://www.google.com/maps/place/Omniversify/@35.4279362,-5.0960211,13z/data=!4m6!3m5!1s0xd0b3594d6ea867d:0xf4cc908008275cc!8m2!3d35.44016!4d-5.0860317!16s%2Fg%2F11t065bzq0?entry=ttu&g_ep=EgoyMDI2MDMxNy4wIKXMDSoASAFQAw%3D%3D"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4 py-2 rounded-lg border border-gold/50 text-gold hover:bg-gold/10 transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 0C7.802 0 4.03 3.603 4.03 7.635c0 5.932 7.97 16.365 7.97 16.365s7.97-10.433 7.97-16.365C19.97 3.603 16.198 0 12 0zm0 10.5c-1.569 0-2.842-1.263-2.842-2.817 0-1.554 1.273-2.817 2.842-2.817 1.568 0 2.841 1.263 2.841 2.817 0 1.554-1.273 2.817-2.841 2.817z"
            ></path>
          </svg>
          Google Maps
        </a>
      </div>
    </div>

    <div class="max-w-md mx-auto">
      <h2 class="gradient-section-title">Get in Touch</h2>
      <p class="text-gold/60 mb-6">Or email us directly at <a href="mailto:support@omniversify.com" class="text-gold underline">support@omniversify.com</a></p>
      <form id="contact-form" class="flex flex-col gap-4">
        <input type="email" id="email" placeholder="Your email" required class="w-full p-4 rounded-lg border-2 border-gold/30 bg-black/30 text-white placeholder:text-white/50 focus:outline-none focus:border-gold transition-colors" />
        <textarea id="message" placeholder="Your message" rows="4" required class="w-full p-4 rounded-lg border-2 border-gold/30 bg-black/30 text-white placeholder:text-white/50 focus:outline-none focus:border-gold transition-colors resize-none"></textarea>
        <button type="submit" class="p-4 bg-gold text-[#1a1a2e] border-none rounded-lg font-semibold cursor-pointer transition-all hover:bg-gold/80 sm:p-4">Send</button>
      </form>
    </div>

    <div class="mt-16 text-center">
      <h2 class="gradient-section-title mb-6">Join Our Discord</h2>
      <div class="rounded-xl overflow-hidden border-2 border-gold/30 inline-block w-full max-w-[350px]">
        <iframe
          id="discord-widget"
          data-src="https://discord.com/widget?id=547089655359864844&theme=dark"
          width="350"
          height="500"
          allowtransparency="true"
          frameborder="0"
          sandbox="allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts"
          class="lazy-iframe w-full"
          title="Discord community widget"
        ></iframe>
      </div>
    </div>
  </div>
</Section>

<script>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = (document.getElementById('email') as HTMLInputElement).value;
    const message = (document.getElementById('message') as HTMLTextAreaElement).value;
    const subject = encodeURIComponent('Contact from Omniversify website');
    const body = encodeURIComponent(`From: ${email}\n\n${message}`);
    window.location.href = `mailto:support@omniversify.com?subject=${subject}&body=${body}`;
    form.reset();
  });

  const lazyIframe = document.querySelector('.lazy-iframe');
  if (lazyIframe instanceof HTMLIFrameElement) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          lazyIframe.src = lazyIframe.dataset.src || '';
          observer.unobserve(lazyIframe);
        }
      });
    });
    observer.observe(lazyIframe);
  }
</script>
