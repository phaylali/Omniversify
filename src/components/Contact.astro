---
import Section from "./Section.astro";
---

<Section>
  <div class="text-center text-white w-full max-w-[900px] mx-auto">
    <!-- Support Section -->
    <h2 class="gradient-title">Support Us</h2>
    <p class="text-xl text-gold mb-12">Help us build infinite worlds</p>

    <div class="flex gap-8 justify-center flex-wrap mb-16">
      <a href="https://ko-fi.com/omniversify" class="support-card">
        <span class="text-3xl">☕</span>
        <span class="text-lg">Buy us Ko-Fi</span>
      </a>
      <a href="https://www.patreon.com/omniversify" class="support-card">
        <span class="text-3xl">⚡</span>
        <span class="text-lg">Patreon</span>
      </a>
      <a href="https://discord.omniversify.com" class="support-card">
        <span class="text-3xl">💬</span>
        <span class="text-lg">Discord</span>
      </a>
    </div>

    <!-- Map -->
    <div class="mt-16 mb-12">
      <h2 class="gradient-title">Visit Us</h2>
      <p class="text-lg text-gold mb-6">45 Av. Al Massira, Oued Laou, Tetouan 93250, Morocco</p>
      <div class="map-container rounded-xl overflow-hidden border-2 border-gold/30">
        <iframe 
          width="100%" 
          height="300" 
          frameborder="0" 
          scrolling="no" 
          marginheight="0" 
          marginwidth="0" 
          src="https://www.openstreetmap.org/node/13663830573?layers=NDG&zoom=19"
          style="border: 0; filter: grayscale(100%) invert(92%) contrast(83%);"
          loading="lazy"
        ></iframe>
      </div>
      <a 
        href="https://www.openstreetmap.org/node/13663830573#map=19/35.440081/-5.084843&layers=NDG" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-block mt-4 text-gold hover:text-gold/80 transition-colors"
      >
        View larger map →
      </a>
    </div>

    <!-- Contact Form -->
    <div class="contact-form max-w-md mx-auto">
      <h2 class="gradient-title">Get in Touch</h2>
      <form class="flex flex-col gap-4">
        <input type="email" placeholder="Your email" class="form-input" />
        <textarea placeholder="Your message" rows="4" class="form-input"></textarea>
        <button type="submit" class="btn-gold">Send</button>
      </form>
    </div>
  </div>
</Section>

<style>
  .gradient-title {
    font-size: 2.5rem;
    margin: 0 0 2rem 0;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: radial-gradient(
      circle at 35% 35%,
      #8a7a3a 0%,
      #c2b067 50%,
      #8a7a3a 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }

  .support-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 2.5rem;
    border-radius: 16px;
    border: 2px solid rgba(194, 176, 103, 0.3);
    background: rgba(0, 0, 0, 0.3);
    text-decoration: none;
    color: white;
    transition: all 0.3s;
    min-width: 150px;
  }

  .support-card:hover {
    box-shadow: 0 0 30px rgba(194, 176, 103, 0.4);
    transform: translateY(-4px);
  }

  .contact-form h3 {
    font-size: 1.5rem;
    color: #c2b067;
    margin-bottom: 1.5rem;
  }

  .form-input {
    width: 100%;
    padding: 1rem 1.25rem;
    border-radius: 8px;
    border: 2px solid rgba(194, 176, 103, 0.3);
    background: rgba(0, 0, 0, 0.3);
    color: white;
    font-size: 1rem;
    transition: border-color 0.2s;
  }

  .form-input:focus {
    outline: none;
    border-color: #c2b067;
  }

  .form-input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .btn-gold {
    padding: 1rem 2rem;
    background: #c2b067;
    color: #1a1a2e;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-gold:hover {
    background: rgba(194, 176, 103, 0.8);
  }

  @media (max-width: 768px) {
    .support-card {
      min-width: 120px;
      padding: 1.5rem;
    }

    .map-container iframe {
      height: 250px;
    }
  }
</style>
