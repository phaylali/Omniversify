---
import { existsSync } from "fs";
import { join } from "path";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const audioFile = slug.replace(/\//g, "-") + ".wav";
const audioPath = join(process.cwd(), "public", "audio", "wiki", audioFile);
const audioUrl = `/audio/wiki/${audioFile}`;
const hasAudio = existsSync(audioPath);
---

{
  hasAudio && (
    <div class="audio-card">
      <div class="audio-card-header">
        <svg class="audio-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 18V5l12-2v13"/>
          <circle cx="6" cy="18" r="3"/>
          <circle cx="18" cy="16" r="3"/>
        </svg>
        <span class="audio-card-label">Listen</span>
      </div>
      <audio src={audioUrl} controls preload="metadata" class="audio-card-player">
        Your browser does not support the audio element.
      </audio>
    </div>
  )
}

<style>
  .audio-card {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(194, 176, 103, 0.2);
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
  }

  .audio-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .audio-card-icon {
    width: 1rem;
    height: 1rem;
    color: #c2b067;
    opacity: 0.8;
    flex-shrink: 0;
  }

  .audio-card-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #c2b067;
    opacity: 0.8;
  }

  .audio-card-player {
    display: block;
    width: 100%;
    height: 36px;
  }

  .audio-card-player::-webkit-media-controls-panel {
    background: transparent;
  }

  .audio-card-player::-webkit-media-controls-current-time-display,
  .audio-card-player::-webkit-media-controls-time-remaining-display {
    color: #c2b067;
  }
</style>
