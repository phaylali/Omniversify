---
interface Props {
  url?: string;
  title?: string;
  description?: string;
}

const { url = "", title = "", description = "" } = Astro.props;

const shareUrl = url || "URL_PLACEHOLDER";
const shareTitle = title || "TITLE_PLACEHOLDER";
