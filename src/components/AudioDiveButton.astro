---
---

<div id="diveButtonContainer" class="absolute bottom-16 left-1/2 -translate-x-1/2 z-20" style="width: 280px; height: 57px;">
  <!-- Background decoration -->
  <img src="/decorationxxlgbutton.svg" alt="" style="width: 280px; height: 57px; display: block; pointer-events: none; position: absolute; top: 0; left: 0; z-index: 5;" />
  
  <!-- Button content -->
  <div style="width: 280px; height: 57px; position: relative;">
    <!-- Text state -->
    <span id="diveText" class="absolute text-gold text-xl font-bold" style="top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 10;">DIVE</span>
    
    <!-- Loading spinner -->
    <span id="loadingSpinner" class="absolute" style="top: 50%; left: 50%; transform: translate(-50%, -50%); display: none; z-index: 10;">
      <svg class="animate-spin h-8 w-8" viewBox="0 0 24 24" fill="none">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="#C2B067" stroke-width="4"></circle>
        <path class="opacity-75" fill="#C2B067" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    </span>
    
    <!-- Audio controls -->
    <span id="audioControls" class="absolute flex items-center gap-2" style="top: 50%; left: 50%; transform: translate(-50%, -50%); display: none; width: 260px; z-index: 20;">
      <button id="pauseBtn" class="text-gold hover:text-white p-1 flex-shrink-0" aria-label="Pause" style="background: transparent; border: none; cursor: pointer;">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
        </svg>
      </button>
      <button id="muteBtn" class="text-gold hover:text-white p-1 flex-shrink-0" aria-label="Mute" style="background: transparent; border: none; cursor: pointer;">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
        </svg>
      </button>
      <div class="flex items-center gap-1 flex-1">
        <svg class="w-3 h-3 text-gold flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path d="M3 9v6h4l5 5V4L7 9H3z"/>
        </svg>
        <input type="range" id="volumeSlider" min="0" max="1" step="0.1" value="0.5" style="flex: 1; height: 4px; accent-color: #C2B067;" />
      </div>
    </span>
  </div>
  
  <!-- Invisible click target for DIVE -->
  <button id="diveBtn" type="button" style="position: absolute; top: 0; left: 0; width: 280px; height: 57px; background: transparent; border: none; cursor: pointer; opacity: 0; z-index: 30;"></button>
</div>

<audio id="bgAudio" src="/DesertedTalesSymph.mp3" preload="auto"></audio>

<script is:inline>
  (function() {
    var diveBtn = document.getElementById('diveBtn');
    var diveText = document.getElementById('diveText');
    var loadingSpinner = document.getElementById('loadingSpinner');
    var audioControls = document.getElementById('audioControls');
    var bgAudio = document.getElementById('bgAudio');
    var muteBtn = document.getElementById('muteBtn');
    var pauseBtn = document.getElementById('pauseBtn');
    var volumeSlider = document.getElementById('volumeSlider');
    var diveButtonContainer = document.getElementById('diveButtonContainer');

    var isPlaying = false;
    var isMuted = false;
    var previousVolume = 0.5;

    diveBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      if (isPlaying) return;
      
      diveText.style.display = 'none';
      loadingSpinner.style.display = 'inline-block';

      bgAudio.play().then(function() {
        isPlaying = true;
        bgAudio.volume = 0.5;
        loadingSpinner.style.display = 'none';
        audioControls.style.display = 'flex';
        diveBtn.style.display = 'none';
      }).catch(function(err) {
        console.error('Audio playback failed:', err);
        diveText.style.display = 'inline';
        loadingSpinner.style.display = 'none';
      });
    });

    muteBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      if (isMuted) {
        bgAudio.volume = previousVolume;
        isMuted = false;
        muteBtn.innerHTML = '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>';
        volumeSlider.value = previousVolume;
      } else {
        previousVolume = bgAudio.volume;
        bgAudio.volume = 0;
        isMuted = true;
        muteBtn.innerHTML = '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>';
        volumeSlider.value = 0;
      }
    });

    pauseBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      if (bgAudio.paused) {
        bgAudio.play();
        pauseBtn.innerHTML = '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';
      } else {
        bgAudio.pause();
        pauseBtn.innerHTML = '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>';
      }
    });

    volumeSlider.addEventListener('input', function(e) {
      bgAudio.volume = e.target.value;
      isMuted = false;
      muteBtn.innerHTML = '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>';
    });
  })();
</script>