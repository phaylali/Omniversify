---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section class:list={["section", className]}>
  <slot />
</section>

<style>
  .section {
    height: 100vh;
    width: 100vw;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 2rem;
    box-sizing: border-box;
  }
</style>
