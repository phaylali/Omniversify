---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section class:list={["section", className]}>
  <slot />
</section>

<style>
  .section {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 4rem 2rem;
    box-sizing: border-box;
  }

  @media (max-width: 768px) {
    .section {
      padding: 3rem 1.5rem;
    }
  }
</style>
