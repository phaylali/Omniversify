---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
	const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
	return `${date.getFullYear()} ${months[date.getMonth()]} ${date.getDate()}`;
}

function getReadingTime(body: string): string {
	const wordsPerMinute = 200;
	const words = body.trim().split(/\s+/).length;
	const minutes = Math.ceil(words / wordsPerMinute);
	return `${minutes} min read`;
}

const readingTime = getReadingTime(post.body);

const coverImage = post.data.image 
  ? `${Astro.url.origin}${post.data.image}` 
  : `${Astro.url.origin}/logo.webp`;
---

<Layout 
  title={`${post.data.title} - Omniversify Blog`} 
  description={post.data.description}
  image={coverImage}
>
  <Navbar />
  <article class="page-container mx-auto max-w-[800px]">
    <header class="mb-12 pb-8 border-b border-gold/20">
      <a href="/blog" class="link-back">← Back to Blog</a>
       
      <div class="flex justify-between items-center text-sm text-gold opacity-70 mb-4">
        <div class="flex gap-2 items-center">
          <span>{formatDate(post.data.pubDate)}</span>
          <span>•</span>
          <span>by {post.data.author}</span>
        </div>
        <span>{readingTime}</span>
      </div>
      
      <h1 class="text-4xl text-gold mb-4 leading-tight">{post.data.title}</h1>
      <p class="text-xl text-gold opacity-80 mb-6 leading-relaxed">{post.data.description}</p>
      
      <div class="flex gap-2 flex-wrap">
        {post.data.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </header>
    
    <div class="content-body">
      <Content />
    </div>
    
    <footer class="mt-16 pt-8 border-t border-gold/20">
      <ShareButtons 
        url={Astro.url.href} 
        title={post.data.title} 
        description={post.data.description} 
      />
    </footer>
  </article>
</Layout>
