---
import Layout from "../../layouts/Layout.astro";
import ButtonRow from "../../components/ButtonRow.astro";
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date) {
	return date.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
}
---

<Layout title="Blog - Omniversify" description="Latest updates, stories, and insights from our team.">
  <main class="page-container">
    <ButtonRow items={[{ href: "/", label: "Back to Home" }]} />
    
    <header class="text-center mb-12">
      <h1 class="gradient-section-title">Blog</h1>
      <p class="text-xl text-gold opacity-80">Latest updates, stories, and insights from our team</p>
    </header>
    
    <div class="grid gap-8 max-w-[1000px] mx-auto" style="grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`} class="block rounded-2xl no-underline border-2 border-gold/30 bg-black/30 overflow-hidden transition-all duration-300 hover:shadow-[0_0_30px_rgba(194,176,103,0.4)] hover:-translate-y-1">
          <div class="p-8">
            <div class="flex gap-4 text-sm text-gold opacity-70 mb-4">
              <span>{formatDate(post.data.pubDate)}</span>
              <span>by {post.data.author}</span>
            </div>
            <h2 class="text-xl text-gold mb-4 leading-tight">{post.data.title}</h2>
            <p class="text-sm text-gold opacity-80 mb-6 leading-relaxed">{post.data.description}</p>
            <div class="flex gap-2 flex-wrap">
              {post.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>
