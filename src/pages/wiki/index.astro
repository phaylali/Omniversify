---
import Layout from "../../layouts/Layout.astro";
import BackButton from "../../components/BackButton.astro";
import { getCollection } from "astro:content";

const wiki = await getCollection("wiki");

const categories = [
  {
    id: "characters",
    name: "Characters",
    icon: "👤",
    description: "Heroes, villains, and legends",
  },
  {
    id: "realms",
    name: "Realms",
    icon: "🌍",
    description: "Worlds, dimensions, and domains",
  },
  {
    id: "weapons",
    name: "Weapons",
    icon: "⚔️",
    description: "Artifacts of immense power",
  },
  {
    id: "events",
    name: "Events",
    icon: "📜",
    description: "Historical moments that shaped existence",
  },
];

const categoryCount = categories.map((cat) => ({
  ...cat,
  count: wiki.filter((item) => item.data.category === cat.id).length,
}));
---

<Layout title="Wiki - Omniversify" description="Explore the lore and history of the Omniversify multiverse.">
  <main class="page-container">
    <BackButton href="/" label="Back to Home" />
    <header class="text-center mb-12">
      <h1 class="gradient-title">Wiki</h1>
      <p class="text-xl text-gold opacity-80">Explore the lore and history of the Omniversify multiverse</p>
    </header>
    
    <div class="grid gap-8 max-w-[1000px] mx-auto" style="grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));">
      {
        categoryCount.map((cat) => (
          <a href={`/wiki/${cat.id}`} class="card-link">
            <div class="text-center p-8">
              <span class="text-4xl mb-4 block">{cat.icon}</span>
              <h2 class="text-xl text-gold uppercase tracking-widest mb-2">{cat.name}</h2>
              <p class="text-sm text-content opacity-80 mb-4">{cat.description}</p>
              <span class="text-xs text-gold opacity-60">{cat.count} entries</span>
            </div>
          </a>
        ))
      }
    </div>
  </main>
</Layout>
