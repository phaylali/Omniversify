---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const wiki = await getCollection('wiki');
  return wiki.map((item) => ({
    params: { category: item.data.category, id: item.id.split('/').pop() },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const categoryInfo: Record<string, { name: string; icon: string }> = {
  characters: { name: 'Characters', icon: '👤' },
  realms: { name: 'Realms', icon: '🌍' },
  weapons: { name: 'Weapons', icon: '⚔️' },
  events: { name: 'Events', icon: '📜' },
};
---

<Layout>
  <Navbar />
  <article class="wiki-entry" style={`--accent-color: ${item.data.color}`}>
    <header class="entry-header">
      <a href={`/wiki/${item.data.category}`} class="back-link">← Back to {categoryInfo[item.data.category].name}</a>
      
      <div class="entry-meta">
        <span class="category-badge">{categoryInfo[item.data.category].icon} {categoryInfo[item.data.category].name}</span>
      </div>
      
      <h1>{item.data.title}</h1>
      <p class="description">{item.data.description}</p>
    </header>
    
    <div class="entry-content">
      <Content />
    </div>
    
    <footer class="entry-footer">
      <a href={`/wiki/${item.data.category}`} class="back-link">← Back to {categoryInfo[item.data.category].name}</a>
    </footer>
  </article>
</Layout>

<style>
  .wiki-entry {
    padding: 8rem 2rem 4rem;
    max-width: 800px;
    margin: 0 auto;
    min-height: 100vh;
    background: rgba(0, 0, 0, 0.3);
  }

  .entry-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(194, 176, 103, 0.2);
  }

  .back-link {
    display: inline-block;
    color: #c2b067;
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
    transition: opacity 0.2s;
  }

  .back-link:hover {
    opacity: 0.8;
  }

  .entry-meta {
    margin-bottom: 1rem;
  }

  .category-badge {
    display: inline-block;
    font-size: 0.8rem;
    padding: 0.4rem 1rem;
    background: rgba(194, 176, 103, 0.2);
    border-radius: 20px;
    color: #c2b067;
  }

  .entry-header h1 {
    font-size: 2.5rem;
    margin: 0 0 1rem;
    color: #c2b067;
    line-height: 1.2;
  }

  .description {
    font-size: 1.2rem;
    color: #c2b067;
    opacity: 0.8;
    margin: 0;
    line-height: 1.6;
  }

  .entry-content {
    color: #F8F5FA;
    line-height: 1.8;
    font-size: 1.1rem;
  }

  .entry-content :global(h1),
  .entry-content :global(h2),
  .entry-content :global(h3) {
    color: #c2b067;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .entry-content :global(h2) {
    font-size: 1.75rem;
    border-bottom: 1px solid rgba(194, 176, 103, 0.2);
    padding-bottom: 0.5rem;
  }

  .entry-content :global(h3) {
    font-size: 1.4rem;
  }

  .entry-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .entry-content :global(ul),
  .entry-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .entry-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .entry-content :global(a) {
    color: #c2b067;
    text-decoration: underline;
  }

  .entry-content :global(blockquote) {
    border-left: 3px solid #c2b067;
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    opacity: 0.9;
    color: #F8F5FA;
  }

  .entry-content :global(strong) {
    font-weight: 600;
  }

  .entry-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(194, 176, 103, 0.2);
  }

  @media (max-width: 600px) {
    .wiki-entry {
      padding: 7rem 1rem 3rem;
    }

    .entry-header h1 {
      font-size: 1.75rem;
    }
  }
</style>
