---
import Layout from "../../../layouts/Layout.astro";
import ButtonRow from "../../../components/ButtonRow.astro";
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const wiki = await getCollection('wiki');
  const categories = ['characters', 'realms', 'weapons', 'events', 'locations'];
  
  return categories.map((category) => ({
    params: { category },
    props: { 
      category,
      items: wiki.filter(item => item.data.category === category)
    },
  }));
}

const { category, items } = Astro.props;

const categoryInfo: Record<string, { name: string; icon: string }> = {
  characters: { name: 'Characters', icon: '👤' },
  realms: { name: 'Realms', icon: '🌍' },
  weapons: { name: 'Weapons', icon: '⚔️' },
  events: { name: 'Events', icon: '📜' },
  locations: { name: 'Locations', icon: '📍' },
};
---

<Layout title={`${categoryInfo[category].name} - Omniversify Wiki`} description={`Explore ${categoryInfo[category].name.toLowerCase()} in the Omniversify multiverse.`}>
  <main class="page-container">
    <ButtonRow items={[{ href: "/wiki", label: "Back to Wiki" }]} />
    
    <header class="text-center mb-12">
      <span class="text-4xl block mb-4">{categoryInfo[category].icon}</span>
      <h1 class="gradient-section-title">{categoryInfo[category].name}</h1>
    </header>
    
    <div class="flex flex-col gap-4 max-w-[800px] mx-auto">
      {items.length > 0 ? (
        items.map((item) => {
          const slug = item.id.split('/').pop();
          return (
            <a href={`/wiki/${category}/${slug}`} class="flex items-center gap-6 p-6 rounded-xl border-2 border-gold/30 bg-black/30 no-underline text-gold transition-all duration-300 hover:shadow-[0_0_20px_rgba(194,176,103,0.3)] hover:translate-x-2" style={{ borderColor: item.data.color }}>
              <span class="w-2 h-[60px] rounded flex-shrink-0" style={{ background: item.data.color }}></span>
              <div>
                <h2 class="text-xl text-gold mb-1">{item.data.title}</h2>
                <p class="text-sm text-content opacity-80 mb-0">{item.data.description}</p>
              </div>
            </a>
          );
        })
      ) : (
        <p class="text-center text-gold opacity-60 py-12 text-lg">No entries yet. Coming soon!</p>
      )}
    </div>
  </main>
</Layout>
