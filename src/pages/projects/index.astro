---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<Layout>
  <Navbar />
  <main class="feed-page">
    <div class="feed-header">
      <h1>Projects</h1>
      <p>Explore our current and upcoming games</p>
    </div>
    
    <div class="projects-grid">
      {projects.map((project) => (
        <a href={`/projects/${project.id}`} class="project-card">
          <div class="project-image" style={`background: ${project.data.gradient}`}>
            <div class="image-placeholder">
              <span>{project.data.title.charAt(0)}</span>
            </div>
          </div>
          <div class="project-content">
            <h2>{project.data.title}</h2>
            <div class="tags">
              {project.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            <p>{project.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>

<style>
  .feed-page {
    padding: 8rem 2rem 4rem;
    min-height: 100vh;
    background: rgba(0, 0, 0, 0.3);
  }

  .feed-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .feed-header h1 {
    font-size: 3rem;
    margin: 0 0 1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: radial-gradient(circle at 35% 35%, #8a7a3a 0%, #c2b067 50%, #8a7a3a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .feed-header p {
    color: #c2b067;
    font-size: 1.25rem;
    opacity: 0.8;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .project-card {
    display: flex;
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: white;
    border: 2px solid rgba(194, 176, 103, 0.3);
    transition: all 0.3s ease;
    background: rgba(0, 0, 0, 0.3);
  }

  .project-card:hover {
    box-shadow: 0 0 30px rgba(194, 176, 103, 0.4);
    transform: translateY(-4px);
  }

  .project-image {
    flex: 0 0 150px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-placeholder {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: bold;
    background: rgba(194, 176, 103, 0.2);
    color: #c2b067;
  }

  .project-content {
    flex: 1;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .project-content h2 {
    font-size: 1.5rem;
    margin: 0 0 0.75rem;
    color: #c2b067;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .tag {
    font-size: 0.7rem;
    padding: 0.25rem 0.75rem;
    background: rgba(194, 176, 103, 0.2);
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #c2b067;
  }

  .project-content p {
    margin: 0;
    font-size: 0.9rem;
    color: #c2b067;
    opacity: 0.8;
    line-height: 1.5;
  }

  @media (max-width: 600px) {
    .project-card {
      flex-direction: column;
    }

    .project-image {
      flex: 0 0 120px;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
