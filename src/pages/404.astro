---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout title="404 - Page Not Found | Omniversify" description="The page you're looking for doesn't exist.">
  <Navbar />
  <main class="min-h-screen flex items-center justify-center px-4">
    <div class="text-center">
      <h1 class="text-9xl font-bold text-gold mb-4">404</h1>
      <p class="text-2xl text-gold mb-8">Page Not Found</p>
      <p class="text-xl text-content mb-8 max-w-md mx-auto">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="px-6 py-3 bg-gold text-black font-semibold rounded-lg hover:bg-gold/80 transition-colors">
          Go Home
        </a>
        <a href="/wiki" class="px-6 py-3 border-2 border-gold text-gold rounded-lg hover:bg-gold/10 transition-colors">
          Explore Wiki
        </a>
      </div>
    </div>
  </main>
</Layout>
