---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

function formatDate(date: Date) {
	const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
	return `${date.getFullYear()} ${months[date.getMonth()]} ${date.getDate()}`;
}

function getReadingTime(body: string): string {
	const wordsPerMinute = 200;
	const words = body.trim().split(/\s+/).length;
	const minutes = Math.ceil(words / wordsPerMinute);
	return `${minutes} min read`;
}

const readingTime = getReadingTime(item.body);
---

<Layout 
  title={`${item.data.title} - Omniversify News`} 
  description={item.data.description}
  image={`${Astro.url.origin}/logo.webp`}
>
  <Navbar />
  <article class="page-container mx-auto max-w-[800px]">
    <header class="mb-12 pb-8 border-b border-gold/20">
      <a href="/news" class="link-back">← Back to News</a>
      
      <span class="tag mb-4">{item.data.category}</span>
      
      <div class="flex justify-between items-center text-sm text-gold opacity-70 mb-4">
        <span>{formatDate(item.data.pubDate)}</span>
        <span>{readingTime}</span>
      </div>
      
      <h1 class="text-4xl text-gold mb-4 leading-tight">{item.data.title}</h1>
      <p class="text-xl text-gold opacity-80 leading-relaxed">{item.data.description}</p>
    </header>
    
    <div class="content-body">
      <Content />
    </div>
    
    <footer class="mt-16 pt-8 border-t border-gold/20">
      <ShareButtons 
        url={Astro.url.href} 
        title={item.data.title} 
        description={item.data.description} 
      />
      <a href="/news" class="link-back mt-8 block">← Back to News</a>
    </footer>
  </article>
</Layout>
