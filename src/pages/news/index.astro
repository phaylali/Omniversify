---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import { getCollection } from 'astro:content';

const news = (await getCollection('news')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date) {
	return date.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
}

const categories = [...new Set(news.map((item) => item.data.category))];
---

<Layout>
  <Navbar />
  <main class="feed-page">
    <div class="feed-header">
      <h1>News</h1>
      <p>Announcements, updates, and latest happenings</p>
    </div>
    
    <div class="news-list">
      {news.map((item) => (
        <a href={`/news/${item.id}`} class="news-card">
          <div class="news-date">
            <span class="day">{item.data.pubDate.getDate()}</span>
            <span class="month">{item.data.pubDate.toLocaleDateString('en-US', { month: 'short' })}</span>
          </div>
          <div class="news-content">
            <span class="category">{item.data.category}</span>
            <h2>{item.data.title}</h2>
            <p>{item.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>

<style>
  .feed-page {
    padding: 8rem 2rem 4rem;
    min-height: 100vh;
    background: rgba(0, 0, 0, 0.3);
  }

  .feed-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .feed-header h1 {
    font-size: 3rem;
    margin: 0 0 1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: radial-gradient(circle at 35% 35%, #8a7a3a 0%, #c2b067 50%, #8a7a3a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .feed-header p {
    color: #c2b067;
    font-size: 1.25rem;
    opacity: 0.8;
  }

  .news-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .news-card {
    display: flex;
    gap: 2rem;
    align-items: center;
    border-radius: 16px;
    text-decoration: none;
    color: white;
    border: 2px solid rgba(194, 176, 103, 0.3);
    transition: all 0.3s ease;
    background: rgba(0, 0, 0, 0.3);
    padding: 1.5rem 2rem;
  }

  .news-card:hover {
    box-shadow: 0 0 30px rgba(194, 176, 103, 0.4);
    transform: translateX(8px);
  }

  .news-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 70px;
    padding: 1rem;
    background: rgba(194, 176, 103, 0.1);
    border-radius: 12px;
  }

  .news-date .day {
    font-size: 1.75rem;
    font-weight: bold;
    color: #c2b067;
    line-height: 1;
  }

  .news-date .month {
    font-size: 0.85rem;
    color: #c2b067;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .news-content {
    flex: 1;
  }

  .category {
    display: inline-block;
    font-size: 0.7rem;
    padding: 0.25rem 0.75rem;
    background: rgba(194, 176, 103, 0.3);
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #c2b067;
    margin-bottom: 0.75rem;
  }

  .news-content h2 {
    font-size: 1.25rem;
    margin: 0 0 0.5rem;
    color: #c2b067;
  }

  .news-content p {
    margin: 0;
    font-size: 0.9rem;
    color: #c2b067;
    opacity: 0.8;
    line-height: 1.5;
  }

  @media (max-width: 600px) {
    .news-card {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }

    .news-date {
      flex-direction: row;
      gap: 0.5rem;
      width: 100%;
      justify-content: center;
    }
  }
</style>
