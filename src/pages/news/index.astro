---
import Layout from "../../layouts/Layout.astro";
import ButtonRow from "../../components/ButtonRow.astro";
import { getCollection } from 'astro:content';

const news = (await getCollection('news')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date) {
	return date.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
}

const categories = [...new Set(news.map((item) => item.data.category))];
---

<Layout title="News - Omniversify" description="Announcements, updates, and latest happenings.">
  <main class="page-container">
    <ButtonRow items={[{ href: "/", label: "Back to Home" }]} />
    
    <header class="text-center mb-12">
      <h1 class="gradient-section-title">News</h1>
      <p class="text-xl text-gold opacity-80">Announcements, updates, and latest happenings</p>
    </header>
    
    <div class="grid gap-8 max-w-[1000px] mx-auto" style="grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));">
      {news.map((item) => (
        <a href={`/news/${item.id}`} class="block rounded-2xl no-underline border-2 border-gold/30 bg-black/30 overflow-hidden transition-all duration-300 hover:shadow-[0_0_30px_rgba(194,176,103,0.4)] hover:-translate-y-1">
          <div class="p-8">
            <div class="flex gap-4 text-sm text-gold opacity-70 mb-4">
              <span>{item.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            </div>
            <span class="inline-block text-xs px-3 py-1 bg-gold/30 rounded-full uppercase tracking-wider text-gold mb-3">{item.data.category}</span>
            <h2 class="text-xl text-gold mb-2 leading-tight">{item.data.title}</h2>
            <p class="text-sm text-gold opacity-80 leading-relaxed mb-0">{item.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>
