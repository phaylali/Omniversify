---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Vision from "../components/Vision.astro";
import ProjectsCarousel from "../components/ProjectsCarousel.astro";
import LoreCarousel from "../components/LoreCarousel.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Volunteer from "src/components/Volunteer.astro";
---

<Layout>
  <main class="h-auto overflow-visible overflow-x-hidden">
    <div class="w-full max-w-full relative">
      <Hero />
    </div>
    <div class="w-full max-w-[1400px] mx-auto">
      <Vision />
      <ProjectsCarousel />
      <LoreCarousel />
      <Volunteer />
      <Contact />
      <Footer />
    </div>
  </main>
</Layout>
