---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Vision from "../components/Vision.astro";
import ProjectsCarousel from "../components/ProjectsCarousel.astro";
import LoreCarousel from "../components/LoreCarousel.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <main class="snap-container">
    <div class="hero-wrapper">
      <Hero />
    </div>
    <div class="page-wrapper">
      <Vision fullHeight={false} />
      <ProjectsCarousel fullHeight={false} />
      <LoreCarousel fullHeight={false} />
      <Contact fullHeight={false} />
      <Footer />
    </div>
  </main>
</Layout>

<style is:global>
  .hero-wrapper {
    width: 100%;
    max-width: 100%;
    position: relative;
  }

  .page-wrapper {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
  }

  .snap-container {
    height: auto;
    overflow-y: visible;
    overflow-x: hidden;
    scroll-snap-type: none;
  }

  /* Carousel styles */
  .carousel-wrapper {
    width: 100%;
    max-width: 100%;
    text-align: center;
    color: white;
    overflow-x: hidden;
    box-sizing: border-box;
  }

  .carousel-wrapper h2 {
    font-size: 2.5rem;
    margin: 0 0 2rem 0;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: radial-gradient(
      circle at 35% 35%,
      #8a7a3a 0%,
      #c2b067 50%,
      #8a7a3a 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .embla {
    padding: 0 1rem;
    overflow: visible;
  }

  .embla__container {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem 0.5rem;
  }

  /* Project Cards - Larger with split layout */
  .project-slide {
    flex: 0 0 70%;
    min-width: 500px;
    max-width: 800px;
    padding: 0.5rem;
    box-sizing: border-box;
  }

  .project-card {
    height: 320px;
    border-radius: 16px;
    display: flex;
    overflow: hidden;
    color: white;
    transition: box-shadow 0.3s;
    cursor: pointer;
    border: 2px solid rgba(194, 176, 103, 0.3);
    background: transparent;
    text-decoration: none;
    width: 100%;
    box-sizing: border-box;
  }

  .project-card:hover {
    box-shadow:
      0 0 30px rgba(194, 176, 103, 0.4),
      0 0 60px rgba(194, 176, 103, 0.2);
  }

  .project-image {
    flex: 0 0 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-placeholder {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    font-weight: bold;
    background: rgba(194, 176, 103, 0.2);
    color: #c2b067;
  }

  .project-info {
    flex: 0 0 50%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
    border-left: 1px solid rgba(194, 176, 103, 0.2);
    background: transparent;
  }

  .project-info h3 {
    font-size: 1.75rem;
    margin: 0 0 1rem 0;
    color: #c2b067;
  }

  .project-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .tag {
    font-size: 0.7rem;
    padding: 0.25rem 0.75rem;
    background: rgba(194, 176, 103, 0.2);
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #c2b067;
  }

  .project-info p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: #c2b067;
    opacity: 0.8;
  }

  /* Responsive Styles */
  @media (max-width: 768px) {
    .snap-container {
      height: auto;
      overflow-y: auto;
      scroll-snap-type: none;
    }

    .page-wrapper {
      max-width: 100%;
    }

    .embla {
      padding: 0 1rem;
    }

    .project-slide {
      flex: 0 0 85vw;
      min-width: 280px;
      max-width: 350px;
    }

    .project-card {
      height: auto;
      min-height: 400px;
      flex-direction: column;
    }

    .project-image {
      flex: 0 0 180px;
      padding: 1.5rem;
    }

    .image-placeholder {
      width: 80px;
      height: 80px;
      font-size: 2rem;
    }

    .project-info {
      flex: 1;
      padding: 1.5rem;
      border-left: none;
      border-top: 1px solid rgba(194, 176, 103, 0.2);
    }

    .project-info h3 {
      font-size: 1.25rem;
      margin: 0 0 0.75rem 0;
    }

    .project-info p {
      font-size: 0.8rem;
    }

    .tag {
      font-size: 0.6rem;
      padding: 0.2rem 0.5rem;
    }

    .carousel-wrapper h2 {
      font-size: 1.5rem;
    }

    .lore-card {
      height: 280px;
    }

    .embla__slide:not(.project-slide) {
      flex: 0 0 200px;
      min-width: 200px;
    }

    .carousel-controls button {
      width: 40px;
      height: 40px;
      font-size: 1rem;
    }
  }

  /* Lore Cards */
  .embla__slide:not(.project-slide) {
    flex: 0 0 280px;
    min-width: 280px;
    padding: 1rem;
  }

  .lore-card {
    height: 350px;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
    color: white;
    transition: box-shadow 0.3s;
    cursor: pointer;
    text-decoration: none;
  }

  .lore-card:hover {
    box-shadow:
      0 0 30px rgba(194, 176, 103, 0.4),
      0 0 60px rgba(194, 176, 103, 0.2);
  }

  .lore-card h3 {
    font-size: 1.5rem;
    margin: 0 0 0.5rem 0;
  }

  .lore-card p {
    margin: 0;
    opacity: 0.9;
  }

  .lore-type {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.7;
    margin-bottom: 0.5rem;
  }

  .carousel-controls {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .carousel-controls button {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.1);
    color: white;
    font-size: 1.25rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .carousel-controls button:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: scale(1.1);
  }
</style>
